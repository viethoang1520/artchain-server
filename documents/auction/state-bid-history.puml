@startuml Bid History State Diagram

skinparam backgroundColor White
skinparam state {
  BackgroundColor #E8E8E8
  BorderColor #888888
  FontColor Black
  FontSize 14
}
skinparam ArrowColor #555555
skinparam ArrowFontSize 12

[*] --> ACTIVE : Place Bid

ACTIVE --> OUTBID : New Higher Bid

ACTIVE --> [*] : Auction Ends (Winner)
OUTBID --> [*]

@enduml
