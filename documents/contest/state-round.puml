@startuml Round State Diagram

skinparam backgroundColor White
skinparam state {
  BackgroundColor #E8E8E8
  BorderColor #888888
  FontColor Black
  FontSize 14
}
skinparam ArrowColor #555555
skinparam ArrowFontSize 12

title Round - State Diagram

[*] --> DRAFT : Create

DRAFT --> ACTIVE : Activate

ACTIVE --> [*]

@enduml
