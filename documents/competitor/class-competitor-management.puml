@startuml Competitor Management

skinparam classAttributeIconSize 0

title Competitor Management - Class Diagram

class Competitor <<Entity>> {
  + competitorId : string <<PK, FK→User>>
  --
  birthday : Date
  schoolName : string
  ward : string
  grade : string
  guardianId : string
}

class User <<Entity>> {
  + userId : string <<UUID, PK>>
  --
  fullName : string
  email : string
  role : UserRole
}

class Painting <<Entity>> {
  + paintingId : string <<UUID, PK>>
  --
  competitorId : string
  contestId : number
  title : string
  status : string
}

class CompetitorsService <<Service>> {
  ' Empty — no methods implemented
}

class CompetitorController <<Controller>> {
  ' Empty — no endpoints implemented
}

note as N1
  CompetitorController and CompetitorsService
  are placeholder modules with no methods.
  Competitor operations are handled by
  GuardiansService and StaffService.
end note

User <|-- Competitor : "userId = competitorId"
Competitor --> User : "guardianId"
Competitor <-- Painting : "competitorId"

CompetitorController --> CompetitorsService

@enduml
