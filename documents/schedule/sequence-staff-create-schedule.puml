@startuml Staff - Create Schedule

skinparam style strictuml
skinparam backgroundColor White
skinparam sequenceMessageAlign center
skinparam sequence {
  ArrowColor #333333
  LifeLineBorderColor #666666
  LifeLineBackgroundColor #F5F5F5
  ParticipantBorderColor #333333
  ParticipantBackgroundColor #FFFFFF
  ParticipantFontSize 13
  ActorBorderColor #333333
  ActorBackgroundColor #FFFFFF
}

actor Staff
participant "ScheduleScreen" as Screen
participant "StaffController" as Controller
participant "StaffService" as Service
participant "UserRepository" as UserRepo
participant "ContestRepository" as ContestRepo
participant "ContestExaminerRepo" as CERepo
participant "ScheduleRepository" as SchedRepo
database "Database" as DB

Staff -> Screen : Access
activate Screen

Screen -> Screen : Select examiner, contest\n& set time range

Screen -> Controller : createSchedule(dto)
activate Controller

Controller -> Service : createSchedule(dto)
activate Service

Service -> UserRepo : findOne({role: EXAMINER})
activate UserRepo
UserRepo -> DB : query
activate DB
DB --> UserRepo : return data
deactivate DB
UserRepo --> Service : return user
deactivate UserRepo

alt Examiner not found
  Service --> Controller : throw NotFoundException
  Controller --> Screen : return 404
  Screen --> Staff : Show error
else Found
  Service -> ContestRepo : findOne({contestId})
  activate ContestRepo
  ContestRepo -> DB : query
  activate DB
  DB --> ContestRepo : return data
  deactivate DB
  ContestRepo --> Service : return contest
  deactivate ContestRepo

  Service -> CERepo : findOne({examinerId, contestId})
  activate CERepo
  CERepo -> DB : query
  activate DB
  DB --> CERepo : return data
  deactivate DB
  CERepo --> Service : return assignment
  deactivate CERepo

  alt Not assigned to contest
    Service --> Controller : throw BadRequestException
    Controller --> Screen : return 400
    Screen --> Staff : Show error
  else Assigned
    Service -> SchedRepo : create & save(schedule)
    activate SchedRepo
    SchedRepo -> DB : insert
    activate DB
    DB --> SchedRepo : return data
    deactivate DB
    SchedRepo --> Service : return schedule
    deactivate SchedRepo

    Service --> Controller : return schedule
    deactivate Service
    Controller --> Screen : return data
    deactivate Controller
    Screen --> Staff : Show success
    deactivate Screen
  end
end

@enduml
