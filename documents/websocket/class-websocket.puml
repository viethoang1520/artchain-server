@startuml WebSocket

skinparam classAttributeIconSize 0

title WebSocket Gateways - Class Diagram

class AuctionsService <<Service>> {
  + placeBid(placeBidDto, userId)
  + joinAuction(auctionId, userId)
}

class AuctionGateway <<WebSocket>> {
  .. namespace: auction ..
  + handleConnection(client: Socket)
  + handleDisconnect(client: Socket)
  + handleJoinAuction(data, socket)
  + handlePlaceBid(data, socket)
}

class Exhibition3DGateway <<WebSocket>> {
  .. namespace: exhibition-3D ..
  + handleConnection(client: Socket)
  + handleDisconnect(client: Socket)
  + handleLocalModelUpdate(data, client)
  + handleLocalModelChatMessage(data, client)
}

class Person <<Type>> {
  id : string
  name : string
  colors : { hairColor, skinColor }
  position : [number, number, number]
  rotation : [number, number, number, string]
}

class LocalModelUpdateDto <<DTO>> {
  id : string
  position : [number, number, number]
  rotation : [number, number, number, string]
  animation : string
}

class LocalModelChatMessageDto <<DTO>> {
  id : string
  message : string
}

AuctionGateway --> AuctionsService : "delegates bids"
Exhibition3DGateway o-- Person : "tracks persons[]"
Exhibition3DGateway ..> LocalModelUpdateDto : "receives"
Exhibition3DGateway ..> LocalModelChatMessageDto : "receives"

@enduml
