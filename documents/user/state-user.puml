@startuml User State Diagram

skinparam backgroundColor White
skinparam state {
  BackgroundColor #E8E8E8
  BorderColor #888888
  FontColor Black
  FontSize 14
}
skinparam ArrowColor #555555
skinparam ArrowFontSize 12

title User - State Diagram

[*] --> ACTIVE : Register

ACTIVE --> INACTIVE : Admin Ban
INACTIVE --> ACTIVE : Admin Activate

@enduml
