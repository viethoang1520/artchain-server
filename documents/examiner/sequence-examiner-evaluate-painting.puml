@startuml Examiner - Evaluate Painting

skinparam style strictuml
skinparam backgroundColor White
skinparam sequenceMessageAlign center
skinparam sequence {
  ArrowColor #333333
  LifeLineBorderColor #666666
  LifeLineBackgroundColor #F5F5F5
  ParticipantBorderColor #333333
  ParticipantBackgroundColor #FFFFFF
  ParticipantFontSize 13
  ActorBorderColor #333333
  ActorBackgroundColor #FFFFFF
}

title Examiner - Evaluate Painting

actor Examiner
participant "EvaluateScreen" as Screen
participant "PaintingsController" as Controller
participant "PaintingsService" as Service
participant "ContestExaminerRepo" as CERepo
participant "ScheduleRepository" as SchedRepo
participant "EvaluationRepository" as EvalRepo
database "Database" as DB

Examiner -> Screen : Access
activate Screen

Screen -> Screen : Fill score form

Screen -> Controller : evaluatePainting(dto)
activate Controller

Controller -> Service : evaluatePainting(dto)
activate Service

Service -> CERepo : findOne({examinerId, contestId})
activate CERepo
CERepo -> DB : query
activate DB
DB --> CERepo : return data
deactivate DB
CERepo --> Service : return assignment
deactivate CERepo

alt Not assigned to contest
  Service --> Controller : throw BadRequestException
  Controller --> Screen : return 400
  Screen --> Examiner : Show error
else Assigned
  Service -> SchedRepo : findOne({examinerId, contestId})
  activate SchedRepo
  SchedRepo -> DB : query
  activate DB
  DB --> SchedRepo : return data
  deactivate DB
  SchedRepo --> Service : return schedule
  deactivate SchedRepo

  Service -> Service : Check schedule\n& isScheduleEnforced

  Service -> EvalRepo : findOne({paintingId, examinerId})
  activate EvalRepo
  EvalRepo -> DB : query
  activate DB
  DB --> EvalRepo : return data
  deactivate DB
  EvalRepo --> Service : return existing
  deactivate EvalRepo

  alt Existing evaluation
    Service -> EvalRepo : save(updated scores)
    activate EvalRepo
    EvalRepo -> DB : update
    activate DB
    DB --> EvalRepo : return data
    deactivate DB
    EvalRepo --> Service : return evaluation
    deactivate EvalRepo
  else New evaluation
    Service -> EvalRepo : create & save(evaluation)
    activate EvalRepo
    EvalRepo -> DB : insert
    activate DB
    DB --> EvalRepo : return data
    deactivate DB
    EvalRepo --> Service : return evaluation
    deactivate EvalRepo
  end

  Service --> Controller : return {canEvaluate, data}
  deactivate Service
  Controller --> Screen : return data
  deactivate Controller
  Screen --> Examiner : Show success
  deactivate Screen
end

@enduml
